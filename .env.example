# Copia este archivo como .env.local para probar en tu computadora.
# En Vercel: Project → Settings → Environment Variables.

# ID del Excel de costeo en Drive (lo que va entre /d/ y /edit en el enlace).
# El archivo debe estar compartido como "Cualquier persona con el enlace puede ver".
EXCEL_FILE_ID=

# Usuarios que pueden entrar, como usuario:contraseña separados por coma.
# El usuario no distingue mayúsculas; la contraseña sí. No uses comas dentro de la contraseña.
# Ejemplo: julian:una-contraseña-larga,socia:otra-contraseña-larga
DASHBOARD_USUARIOS=

# Llave para firmar la sesión: texto aleatorio de 32 caracteres o más.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si la cambias, todos tendrán que volver a entrar.
SESSION_SECRET=

# API key de https://resend.com/api-keys
RESEND_API_KEY=

# Correo(s) que reciben el ticket, separados por coma.
# Sin dominio verificado en Resend, solo puede ser el correo de tu cuenta de Resend.
TICKET_TO=

# Opcional: remitente. Por defecto "Relato café <onboarding@resend.dev>".
RESEND_FROM=
