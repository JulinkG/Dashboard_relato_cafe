# Copia este archivo como .env.local para probar en tu computadora.
# En Vercel: Project → Settings → Environment Variables.

# ID del Excel de costeo en Drive (lo que va entre /d/ y /edit en el enlace).
# El archivo debe estar compartido como "Cualquier persona con el enlace puede ver".
EXCEL_FILE_ID=

# API key de https://resend.com/api-keys
RESEND_API_KEY=

# Correo(s) que reciben el ticket, separados por coma.
# Sin dominio verificado en Resend, solo puede ser el correo de tu cuenta de Resend.
TICKET_TO=

# Opcional: remitente. Por defecto "Relato café <onboarding@resend.dev>".
RESEND_FROM=
